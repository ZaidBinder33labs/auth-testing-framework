# Target application under test
TARGET_BASE_URL=http://localhost:3000
TARGET_API_URL=http://localhost:3001

# Identity
E2E_EMAIL=user@example.com
E2E_PASSWORD=changeme

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_MODE=READ_ONLY
REDIS_NAMESPACE=auth-test
REDIS_TTL_TOLERANCE_MS=2000

# Redis connection (Phase 2)
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=true
REDIS_CA=
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000

# Snapshot / diff
SNAPSHOT_TTL_TOLERANCE_MS=2000

# Concurrency
CONCURRENT_REFRESH_LOCK_MS=5000

# Reporting
REPORT_DIR=reports